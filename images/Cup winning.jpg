n:-0.175em;width:1rem;height:1rem;box-sizing:content-box"></i></a> <!-- -->You can change your cookie settings any time.</div></div><hr aria-hidden="true" class="ld_Au"/><footer class="ph3 ph6-hdkp"><div class="w-100 flex justify-end mt4"><button class="ld_CJ ld_CP mr2 db" type="button" data-dca-aid="B:8D6247D1F1" data-dca-intent="open" data-dca-event="__DCA_EVENT_TBD__" role="link">Manage cookie settings</button><button class="ld_i ld_k ld_o" type="button" data-dca-aid="B:54DA07ECC2" data-dca-intent="__DCA_TBD__" data-dca-event="__DCA_EVENT_TBD__" aria-label="close button">Close</button></div></footer></section></div><div id="header-chatbot-container"></div><span class="ld_Ec" aria-live="assertive" data-live-announcer="true"></span><span class="ld_Ec" aria-live="polite" data-live-announcer="true"></span></div><script id="__NEXT_DATA__" type="application/json" nonce="3i_snURTmzyBidB6">{"props":{"pageProps":{"initialData":{"data":{"contentLayout":{"cov":[],"modules":[{"configs":{"__typename":"TempoWM_GLASSWWWInterPageNavigationBannerConfigs","moduleSubtype":"INTER_PAGE","bannerImage":{"src":"https://i5.walmartimages.ca/dfw/8822aef6-458f/k2-_01122f93-d48d-4cf8-9550-f95b2eb21bab.v1.png","assetId":"5ba36a6a-ece6-47d0-fb22-caf5abf3b81f","assetName":"PIP_WMPlus-Membership-that-delivers-Save650-688x88_E.png","height":"88","width":"688","alt":"Membership that delivers.™"},"destination":{"title":"Try it free","clickThrough":{"value":"https://www.walmart.ca/en/plus?icid=item_page_other_wplus_pipbanner_nonmember_189841_P7G7LB861M"}},"bannerCtaGroup":{"textColor":"#FFFFFF","bannerCta":{"linkText":"Try it free","title":"Try it free","clickThrough":{"value":"https://www.walmart.ca/en/plus?icid=item_page_other_wplus_pipbanner_nonmember_189841_P7G7LB861M"}}}},"moduleId":"7ab2f267-034e-4521-adce-9cfab37212df","matchedTrigger":{"pageType":"ItemPageDesktopByCategory","pageId":"10010","zone":"rightMiddleZone19","inheritable":true},"name":"Glass WEB: BTS x Walmart + \"Non Member\" PIP Banner Wk 26 2026","type":"InterPageNavigationBanner","version":2,"status":"published","publishedDate":1786037237509},{"configs":{"__typename":"TempoWM_GLASSWWWBuyBoxAdConfigs","_rawConfigs":{"buyBoxType":"default","isStickyBuybox":"False","lazy":"50","moduleLocation":"top","title":""},"moduleLocation":"top","lazy":"50","ad":null,"isStickyBuybox":"False","videoEnabled":null},"moduleId":"ec4839ac-7aeb-47ff-9349-72379751fa62","matchedTrigger":{"pageType":"ItemPageGlobalDesktop","pageId":"global_evergreen","zone":"rightBottomZone2","inheritable":false},"name":"Buy Box Ad Container Module for Desktop","type":"BuyBoxAd","version":7,"status":"published","publishedDate":1752539810699},{"configs":{"__typename":"TempoWM_GLASSWWWCustomHtmlConfigs","markup":"\u003c!DOCTYPE html\u003e\n\u003chtml\u003e\n   \u003chead\u003e\n      \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1\"\u003e\n      \u003clink\n         rel=\"stylesheet\"\n         href=\"https://unpkg.com/tachyons@4.12.0/css/tachyons.min.css\"\n         /\u003e\n   \u003c/head\u003e\n   \u003cbody\u003e\n      \u003cdiv class=\"flex flex-column justify-center w-100 ph3 normal lh-copy pt1\"\u003e\n            \u003cdiv class=\"tc\"\u003e\n               \u003cimg src=\"https://i5.walmartimages.com/dfw/8822aef6-7abe/k2-_f4ee767f-a90a-4f70-be39-71e5d7b238a0.v1.jpg\"\u003e\n               \u003ch3\u003e4 equal payments\u003c/h3\u003e\n               \u003ch4 class=\"gray\"\u003eBuy what you love and split the cost. It's that easy. \u003c/h4\u003e\n            \u003c/div\u003e\n            \u003cul\u003e\n            \u003cb\u003e\n               \u003cli\u003eAdd item(s) to your cart.\u003c/li\u003e\n               \u003cli\u003e\n                  Add items to checkout and choose \n                  \u003cimage height=\"14\" width=\"auto\" src=\"https://i5.walmartimages.com/dfw/8822aef6-7abe/k2-_f4ee767f-a90a-4f70-be39-71e5d7b238a0.v1.jpg\"\u003e\u003c/image\u003e\n               \u003c/li\u003e\n               \u003cli\u003eEnter your debit or credit card information. \u003c/li\u003e\n               \u003cli\u003eYour first payment is taken when the order is processed, and the remaining 3 are automatically taken every two weeks.\u003c/li\u003e\n            \u003c/b\u003e\n            \u003c/ul\u003e\n            \u003cp class=\"gray\"\u003ePlease note that a higher initial payment may be required for some purchases. Pay later in 4 \u003ca href=\"https://cdn.klarna.com/1.0/shared/content/legal/terms/0/en_ca/paylaterin4\" target=\"_blank\"\u003eterms\u003c/a\u003e available here. For Quebec residents, these Pay Later 4 \u003ca href=\"https://cdn.klarna.com/1.0/shared/content/legal/terms/0/en_ca/paylaterin4_quebec\" target=\"_blank\"\u003eterms\u003c/a\u003e are applicable. \u003c/p\u003e\n      \u003c/div\u003e\n   \u003c/body\u003e\n\u003c/html\u003e"},"moduleId":"785e9579-9ed7-42e5-82f8-5940bb07fc63","matchedTrigger":{"pageType":"ItemPageGlobalDesktop","pageId":"global_evergreen","zone":"leftZone39","inheritable":false},"name":"Custom HTML Module - About Klarna","type":"CustomHtml","version":15,"status":"published","publishedDate":1752550438621},{"configs":{"__typename":"TempoWM_GLASSWWWCustomHtmlConfigs","markup":"\u003c!DOCTYPE html\u003e\n\u003chtml lang=\"en\"\u003e\n  \u003chead\u003e\n    \u003cmeta charset=\"UTF-8\" /\u003e\n    \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1\" /\u003e\n    \u003clink\n      rel=\"stylesheet\"\n      href=\"https://unpkg.com/tachyons@4.12.0/css/tachyons.min.css\"\n    /\u003e\n    \u003cstyle\u003e\n      body,\n      html {\n        font-family: 'Everyday Sans', Arial, sans-serif;\n      }\n\n      li {\n        margin-bottom: 0.5rem;\n      }\n    \u003c/style\u003e\n    \u003ctitle\u003eWalmart Installment Plan\u003c/title\u003e\n  \u003c/head\u003e\n\n  \u003cbody\u003e\n    \u003cdiv class=\"col-container w-100 normal lh-copy pt1\"\u003e\n      \u003cdiv class=\"col tc\"\u003e\n        \u003cimg\n          width=\"35%\"\n          src=\"https://i5.walmartimages.com/dfw/8822aef6-971e/k2-_ed78b905-6394-4f88-a805-ab299123f2cc.v1.png\"\n          alt=\"Walmart Installment Plan\"\n        /\u003e\n\n        \u003ch3\u003eShop today, take time to pay\u003c/h3\u003e\n        \u003cp\u003e\n          Split your purchase into 6 equal installments*  /\n          \u003ca\n            href=\"https://i5.walmartimages.ca/dfw/8822aef6-d3f1/k2-_417f32f7-5074-45a6-b23d-5d5b3039e5b8.v1.pdf\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n          \u003e\n            Terms and Conditions apply\n          \u003c/a\u003e\n        \u003c/p\u003e\n\n        \u003ch4\u003eHere's how it works\u003c/h4\u003e\n        \u003cul class=\"tl\"\u003e\n          \u003cli\u003eSpend $199.99 or more on walmart.ca**\u003c/li\u003e\n          \u003cli\u003eSelect Installment Plan at checkout\u003c/li\u003e\n          \u003cli\u003e\n            Pay with your Walmart Rewards Mastercard. If you don't have one,\n            click \"Apply Now\".\n          \u003c/li\u003e\n        \u003c/ul\u003e\n\n        \u003ch4\u003eDetails\u003c/h4\u003e\n        \u003cp\u003e\n          Your qualifying purchase will be split into 6 equal monthly\n          installments charged to your Walmart Rewards Mastercard. If your items\n          ship on separate dates, each shipment will be converted to a separate\n          Installment Plan.\n        \u003c/p\u003e\n\n        \u003ch4\u003eDon't have a Walmart Rewards Mastercard?\u003c/h4\u003e\n        \u003cp\u003e\n          Apply now and upon approval use your new account to enjoy the\n          convenience of an Installment Plan on eligible purchases*. Purchased\n          items must appear on a single receipt totaling $199.99 or more (before\n          taxes, discounts, Walmart Reward Dollar™ redemptions, and\n          shipping/delivery fees)∆\n        \u003c/p\u003e\n\n        \u003cp\u003e\n          *See\n          